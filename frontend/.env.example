# Application
APP_URL="http://localhost:3000"
DEPLOYMENT_VERSION="development"

# Database
DATABASE_URL="mysql://USERNAME:PASSWORD@127.0.0.1:3306/tryvora"
TEST_DATABASE_URL="mysql://USERNAME:PASSWORD@127.0.0.1:3306/tryvora_test"

# Authentication
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_TEMPORARY_EXPIRES_IN="8h"
GUEST_SESSION_EXPIRES_IN="24h"

# Password-reset delivery: console is development-only; production requires smtp.
MAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Set APP_URL above to the public HTTPS application URL in production.

# Initial administrator
ADMIN_NAME="TryVora Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Private Digital Twin storage
PRIVATE_STORAGE_ROOT="./private-storage"
DATA_ENCRYPTION_KEY="replace-with-a-64-character-hexadecimal-key"
DIGITAL_TWIN_URL_SIGNING_SECRET="replace-with-at-least-32-random-characters"
DELETED_TWIN_RETENTION_DAYS="30"
MAX_UPLOAD_SIZE_MB="5"

# Try-On limits
MAX_CONCURRENT_TRY_ONS="2"
